# STAGING PLACEHOLDERS ONLY — never commit real credentials.
# Copy to an ignored, owner-restricted file managed by deployment secrets.
CAD_PUBLIC_RESOURCE_URL=https://cad-staging.example.net/mcp
CAD_STAGING_FQDN=cad-staging.example.net
CAD_OAUTH_ISSUER=https://STAGING_REF.supabase.co/auth/v1
CAD_ALLOWED_ORIGINS=https://chatgpt.com
CAD_STAGING_DATABASE_URL=postgresql://staging_user:PLACEHOLDER@staging-db.example.net:5432/postgres?sslmode=require
CAD_WORKER_OWNER_ID=11111111-1111-4111-8111-111111111111
CAD_WORKER_ID=cad_worker_1
CADCRAFT_BIN_SHA256=REPLACE_WITH_VERIFIED_EXECUTABLE_DIGEST
CAD_STAGING_S3_ENDPOINT=https://staging-storage.example.net
CAD_STAGING_S3_BUCKET=cad-staging-bucket
CAD_STAGING_S3_REGION=ap-south-1
CAD_STAGING_S3_ACCESS_KEY_ID=PLACEHOLDER
CAD_STAGING_S3_SECRET_ACCESS_KEY=PLACEHOLDER
CAD_STAGING_TLS_CERT_PATH=/absolute/path/to/staging-fullchain.pem
CAD_STAGING_TLS_KEY_PATH=/absolute/path/to/staging-privkey.pem
