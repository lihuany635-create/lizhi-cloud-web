{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lihuany635-create.github.io/lizhi-cloud-laptop-6s8a4kuk/schemas/weaving-proposal.schema.json",
  "title": "Knowledge Weaving Proposal Schema Version 1",
  "description": "AI/nanobot 只能提出此 Proposal；approved 僅表示使用者完成人工審核，不表示已寫入 Obsidian。",
  "type": "object",
  "required": [
    "schema_version", "id", "title", "summary", "sources", "created_at", "domain_candidates",
    "node_candidates", "relation_candidates", "suggested_markdown", "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "inbox_source": {"enum": ["mock", "nanobot", "other"]},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object", "required": ["label"],
            "properties": {"label": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri"}},
            "additionalProperties": false
          }
        ]
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "domain_candidates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["domain", "reason"],
        "properties": {
          "domain": {"$ref": "#/$defs/domain"},
          "reason": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "node_candidates": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "title", "domain", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "domain": {"oneOf": [{"$ref": "#/$defs/domain"}, {"type": "null"}]},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "relation_candidates": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "type", "target_node_id", "target_title", "reason", "decision"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["extends", "supports", "contradicts", "example-of", "same-topic", "prerequisite", "application", "replace"]},
          "target_node_id": {"type": "string", "minLength": 1},
          "target_title": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "decision": {"enum": ["pending", "accepted", "rejected"]},
          "decided_by": {"enum": ["user"]}
        },
        "additionalProperties": false
      }
    },
    "suggested_markdown": {"type": "string", "minLength": 1},
    "status": {"enum": ["researching", "waiting_review", "reviewing", "approved", "rejected", "deferred"]},
    "review": {
      "type": "object",
      "properties": {
        "selected_domain": {"oneOf": [{"$ref": "#/$defs/domain"}, {"type": "null"}]},
        "domain_resolution": {"enum": ["selected", "split", "deferred", null]},
        "domain_selected_by": {"enum": ["user"]},
        "approved_by": {"enum": ["user"]},
        "reviewed_by": {"enum": ["user"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "domain": {"enum": ["ai", "civil", "software", "media", "learning", "humanities"]}
  },
  "additionalProperties": false
}
